{
  "name": "monavi-social-automation",
  "private": true,
  "type": "module",
  "description": "Monavi Collection social media automation: branded posts, reels and Buffer publishing.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "render:post": "node scripts/render-post.ts",
    "render:reel": "node scripts/render-reel.ts",
    "check:media": "node scripts/check-media.ts",
    "buffer": "node --env-file-if-exists=.env scripts/buffer.ts",
    "typecheck": "tsc --noEmit",
    "import:photo": "node scripts/import-photo.ts",
    "plan": "node --env-file-if-exists=.env scripts/publish-plan.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1165.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
