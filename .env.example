# Buffer personal API key — create at https://publish.buffer.com/settings/api
BUFFER_API_KEY=

# Public media hosting for Buffer (Cloudflare R2) — only needed for `npm run buffer -- post --host`
# In GitHub these are repository secrets used by .github/workflows/schedule-on-merge.yml
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MEDIA_PUBLIC_BASE_URL=
