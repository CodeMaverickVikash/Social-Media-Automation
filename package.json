{
  "name": "monavi-social-automation",
  "private": true,
  "type": "module",
  "description": "Monavi Collection social media automation: branded posts, reels and Buffer publishing.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "doctor": "node scripts/doctor.ts",
    "render:post": "node scripts/render-post.ts",
    "render:reel": "node scripts/render-reel.ts",
    "check:media": "node scripts/check-media.ts",
    "buffer": "node scripts/buffer.ts",
    "typecheck": "tsc --noEmit",
    "import:photo": "node scripts/import-photo.ts",
    "draw:product": "node scripts/draw-product.ts",
    "plan": "node scripts/publish-plan.ts",
    "clean:output": "node scripts/clean-output.ts",
    "clean:branches": "node scripts/clean-branches.ts",
    "clean:content": "node scripts/clean-content.ts",
    "clean:merged": "node scripts/clean-merged.ts"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
